; Import library for the few kernel32 calls reroll makes (stdcall-decorated).
LIBRARY kernel32.dll
EXPORTS
    CreateFileA@28
    FlushInstructionCache@12
    GetCurrentProcess@0
    GetEnvironmentVariableA@12
    QueryPerformanceCounter@4
    QueryPerformanceFrequency@4
    VirtualAlloc@16
    VirtualFree@12
    VirtualQuery@12
    GetTickCount@0
    Sleep@4
    VirtualProtect@16
    WriteFile@20
    CloseHandle@4
    CreateDirectoryA@8
    GetCurrentProcessId@0
    CreateFileMappingA@24
    MapViewOfFile@20
    AddVectoredExceptionHandler@8
    GetProcessHeap@0
    HeapAlloc@12
    HeapReAlloc@16
    HeapFree@12
    LoadLibraryA@4
    GetProcAddress@8
    GetModuleHandleA@4
    ReadFile@20
    GetFileSize@8
    ExitProcess@4
    GetCommandLineA@0
    GetStdHandle@4
